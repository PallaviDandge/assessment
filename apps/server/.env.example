# Server-side only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low keeps latency inside the 8s budget for these short tasks
LLM_EFFORT=low
LLM_TIMEOUT_MS=8000
PORT=4000
CORS_ORIGIN=http://localhost:3000
# AI endpoints: requests per minute per session
RATE_LIMIT_PER_MINUTE=20
