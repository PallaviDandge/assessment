# Server-side only. Never prefix with NEXT_PUBLIC_.

# Option A: Claude API directly (default)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Option B: Claude via OpenRouter (same Anthropic SDK, Anthropic-compatible endpoint)
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=

# Optional. Defaults: claude-opus-5-5 (anthropic) / anthropic/claude-opus-5.5 (openrouter)
ANTHROPIC_MODEL=
# low keeps latency inside the 8s budget for these short tasks
LLM_EFFORT=low
# includes thinking tokens; lower it only if your credit balance forces you to
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=8000
PORT=4000
CORS_ORIGIN=http://localhost:3000
# AI endpoints: requests per minute per session
RATE_LIMIT_PER_MINUTE=20
